# Shared Buzz/Kaneo endpoints and the human owner identity.
BUZZ_RELAY_URL=wss://buzz.darimuri.me
KANEO_API_URL=https://kaneo.darimuri.me
BUZZ_AGENT_OWNER_HEX=replace-with-64-char-owner-pubkey
BUZZ_OWNER_PRIVATE_KEY_FILE=/home2/dormael/buzz/owner-private-key.hex
BUZZ_NAK_BIN=/home2/dormael/buzz/.tools/nak
BUZZ_NIP_OA_IMAGE=local/buzz-nip-oa:c8f7321
BUZZ_NIP_OA_SOURCE_COMMIT=c8f73213089cbd5a0f1e675d3193558280d46e10

# Agents operate across repositories in this organization. A trusted host adds an
# independent clone for each agent with scripts/provision-agent-repository.sh.
AGENT_WORKSPACE_ORGANIZATION=darimuri
AGENT_WORKSPACE_GIT_URL_TEMPLATE=git@github.com:{owner}/{repository}.git
AGENT_WORKSPACE_DEFAULT_REF=main
AGENT_RUNTIME_ROOT=${HOME}/buzz-agents
# Required external approved mapping; never use the example identities in production.
AGENT_GIT_IDENTITY_MANIFEST=${HOME}/.config/darimuri-agent-orchestration/git-identities.json

# github-app-agent-gateway runs only on the private Compose network. Build this
# tag from the separate darimuri/github-app-agent-gateway repository first.
GITHUB_GATEWAY_IMAGE=local/github-app-agent-gateway:196c5a3
GITHUB_GATEWAY_MCP_URL=http://github-gateway:8787/mcp
GITHUB_GATEWAY_ALLOWED_OWNERS=darimuri
GITHUB_CONTROL_APP_SLUG=darimuri-agent-control-a
GITHUB_DEVELOPER_APP_SLUG=darimuri-agent-developer-a
GITHUB_REVIEWER_APP_SLUG=darimuri-agent-reviewer-a
GITHUB_GATEWAY_CREDENTIALS_BASE_DIR=${HOME}/.config/darimuri-agent-orchestration
GITHUB_GATEWAY_CREDENTIALS_ROOT=${GITHUB_GATEWAY_CREDENTIALS_BASE_DIR}/github-apps
GITHUB_GATEWAY_RUNTIME_DIR=${AGENT_RUNTIME_ROOT}/github-gateway

# Each agent gets a different host credential directory and organization
# workspace. Repositories provisioned under these roots are never shared.
DISPATCHER_CREDENTIALS_DIR=${AGENT_RUNTIME_ROOT}/dispatcher-planner/credentials
DISPATCHER_WORKSPACE=${AGENT_RUNTIME_ROOT}/dispatcher-planner/workspace

DEVELOPER_CREDENTIALS_DIR=${AGENT_RUNTIME_ROOT}/developer-a/credentials
DEVELOPER_WORKSPACE=${AGENT_RUNTIME_ROOT}/developer-a/workspace

REVIEWER_CREDENTIALS_DIR=${AGENT_RUNTIME_ROOT}/reviewer-a/credentials
REVIEWER_WORKSPACE=${AGENT_RUNTIME_ROOT}/reviewer-a/workspace

# Model defaults can be overridden after `buzz-acp models --json` confirms
# what each mounted provider credential can access.
DISPATCHER_PROVIDER=claude
DISPATCHER_IMAGE=local/buzz-agent-claude:2.1.278
DISPATCHER_DOCKERFILE=docker/Dockerfile.claude
DISPATCHER_MODEL=claude-sonnet-5

DEVELOPER_PROVIDER=codex
DEVELOPER_MODEL=gpt-5.3-codex

REVIEWER_PROVIDER=claude
REVIEWER_IMAGE=local/buzz-agent-claude:2.1.278
REVIEWER_DOCKERFILE=docker/Dockerfile.claude
REVIEWER_MODEL=claude-opus-5

# Reproducible build inputs. Update intentionally, then rebuild both images.
AGENT_BUZZ_SPRIG_IMAGE=ghcr.io/block/buzz-sprig:sha-6530b58@sha256:17facfc7608d8ddb33bc056c9aaba1098f4ef6abe5655702fbfd7584d1f74d76
AGENT_CLAUDE_CODE_VERSION=2.1.278
AGENT_CLAUDE_ACP_VERSION=0.79.0
AGENT_CODEX_VERSION=0.154.0
AGENT_CODEX_ACP_VERSION=1.12.0
AGENT_KANEO_MCP_VERSION=0.1.11
