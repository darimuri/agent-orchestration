# syntax=docker/dockerfile:1.7

ARG BUZZ_SPRIG_IMAGE=ghcr.io/block/buzz-sprig:sha-6530b58@sha256:17facfc7608d8ddb33bc056c9aaba1098f4ef6abe5655702fbfd7584d1f74d76
FROM ${BUZZ_SPRIG_IMAGE} AS buzz-runtime

FROM node:22-bookworm-slim AS runtime

ARG CLAUDE_CODE_VERSION=2.1.278
ARG CLAUDE_ACP_VERSION=0.79.0
ARG KANEO_MCP_VERSION=0.1.11

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl git jq openssh-client ripgrep tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g \
       "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
       "@agentclientprotocol/claude-agent-acp@${CLAUDE_ACP_VERSION}" \
       "@kaneo/mcp@${KANEO_MCP_VERSION}" \
    && npm cache clean --force

COPY --from=buzz-runtime /usr/local/bin/sprig /usr/local/bin/sprig
COPY docker/agent-entrypoint.sh /usr/local/bin/agent-entrypoint
COPY docker/git-identity.mjs /usr/local/bin/git-identity.mjs
COPY docker/generate-mcp-config.mjs /usr/local/libexec/generate-mcp-config.mjs
COPY docker/kaneo-mcp-safe-proxy.mjs /usr/local/libexec/kaneo-mcp-safe-proxy.mjs
COPY mcp/servers.json /etc/buzz-agent/mcp-servers.json

RUN groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent \
    && ln -s sprig /usr/local/bin/buzz \
    && ln -s sprig /usr/local/bin/buzz-acp \
    && ln -s sprig /usr/local/bin/buzz-dev-mcp \
    && ln -s sprig /usr/local/bin/git-credential-nostr \
    && ln -s sprig /usr/local/bin/git-sign-nostr \
    && ln -s /usr/local/libexec/kaneo-mcp-safe-proxy.mjs /usr/local/bin/kaneo-mcp-safe-proxy \
    && chmod 0755 /usr/local/bin/agent-entrypoint /usr/local/libexec/*.mjs \
    && mkdir -p /workspace /run/agent/prompts /run/agent/credentials \
       /home/agent/.agent /home/agent/.cache /home/agent/.config /home/agent/.codex \
    && chown -R agent:agent /workspace /home/agent

ENV HOME=/home/agent \
    XDG_CONFIG_HOME=/home/agent/.config \
    XDG_CACHE_HOME=/home/agent/.cache \
    DISABLE_AUTOUPDATER=1 \
    AGENT_PROVIDER=claude \
    BUZZ_ACP_AGENT_COMMAND=claude-agent-acp \
    BUZZ_ACP_AGENT_ARGS=

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-entrypoint"]
CMD ["buzz-acp"]
